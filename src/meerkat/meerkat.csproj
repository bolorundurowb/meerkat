<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>meerkat</PackageId>
    <PackageVersion>3.0.0</PackageVersion>
    <Title>Meerkat</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Winner-Timothy Bolorunduro</Authors>
    <Description>An ODM for MongoDB</Description>
    <Copyright>© 2021-2026, Bolorunduro Winner-Timothy. All Rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/bolorundurowb/meerkat</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/bolorundurowb/meerkat/blob/master/LICENSE</PackageLicenseUrl>
    <RepositoryUrl>https://github.com/bolorundurowb/meerkat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>meerkat mongodb mongoose odm mongodb-driver dotnet csharp netstandard orm data-access document-database nosql nuget linq indexing</PackageTags>
    <PackageReleaseNotes>
      3.0.0
      - Add ambient multi-document transactions via WithTransaction / WithTransactionAsync (writes and reads join the session automatically).
      - Add EnsureIndexes / EnsureIndexesAsync to create and verify attribute indexes at startup; missing indexes throw IndexVerificationException.
      - Add TTL indexes with SingleFieldIndex.ExpireAfter (durations such as "30d", "12h", or ISO-8601).
      - Add Unique on CompoundIndex for uniqueness across grouped fields.
      - Add opt-in soft delete ([Collection(SoftDelete = true)]): queries/counts/updates skip deleted documents by default; Restore* and HardRemove* for restore and permanent delete.
      - Add fluent atomic partial updates (Set, Unset, Push, Pull, AddToSet, Inc) with Update / UpdateOne / UpdateMany.
      - Replace mongo-url-parser with ciu-parser for connection-string parsing; bump MongoDB.Driver to 3.12.0.
    </PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Company>bolorundurowb</Company>
    <NeutralLanguage>en-NG</NeutralLanguage>
    <AssemblyName>Meerkat</AssemblyName>
    <Nullable>enable</Nullable>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ciu-parser" Version="3.2.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="NodaTime" Version="3.3.4" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="meerkat.Tests" />
  </ItemGroup>
</Project>
